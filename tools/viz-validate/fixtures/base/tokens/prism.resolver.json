{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "viz-validate base",
  "version": "2025.10",
  "description": "tools/viz-validate fixture base: four series slots whose light and dark steps pass all six checks, a neutral now marker and an opaque plot in each scheme. Every other case overlays the files its defect touches.",
  "sets": {
    "ref": {
      "sources": [
        {
          "$ref": "ref/color.tokens.json"
        },
        {
          "$ref": "ref/series.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "colorScheme": {
      "contexts": {
        "light": [
          {
            "$ref": "sys/color/light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "sys/color/dark.tokens.json"
          }
        ]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/ref"
    },
    {
      "$ref": "#/modifiers/colorScheme"
    }
  ]
}
