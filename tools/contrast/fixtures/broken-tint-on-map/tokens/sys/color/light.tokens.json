{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "bg": {
        "page": {
          "$value": "{ref.color.slot.light.bg-page}"
        },
        "fill": {
          "accent": {
            "$value": "{ref.color.slot.light.bg-fill-accent}"
          }
        },
        "tint": {
          "critical": {
            "$value": "{ref.color.status.danger.dot-light}",
            "$extensions": {
              "app.prism": {
                "alpha": 0.12
              }
            }
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page"
                ]
              }
            }
          }
        },
        "secondary": {
          "$value": "{ref.color.neutral.600}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page"
                ]
              }
            }
          }
        },
        "on-accent": {
          "$value": "{ref.color.slot.light.text-on-accent}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.fill.accent"
                ]
              }
            }
          }
        },
        "accent": {
          "$value": "{ref.color.slot.light.text-accent}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page"
                ]
              }
            }
          }
        },
        "critical": {
          "$value": "{ref.color.status.danger.text-light}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.tint.critical"
                ]
              }
            }
          }
        }
      },
      "map": {
        "land": {
          "$value": "{sys.color.bg.page}"
        },
        "road": {
          "$value": "{ref.color.neutral.0}"
        }
      }
    }
  }
}
