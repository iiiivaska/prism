{
  "name": "@iiiivaska/prism-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build and check tooling: token build (Style Dictionary 5 + resolver driver), Terrazzo lint, contrast, spec validation, icon registry validation, parity report, license gate, notices, literal-values guard",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:literals": "node lint/literals.ts",
    "tokens:build": "node tokens/build.ts",
    "tokens:lint": "tz lint --config tokens/terrazzo.config.ts",
    "tokens:diff": "node tokens/diff.ts",
    "contrast:check": "node contrast/check.ts",
    "spec:validate": "node spec/validate.ts",
    "icons:validate": "node icons/validate.ts",
    "parity:report": "node parity/report.ts",
    "licenses:check": "node licenses/check.ts",
    "licenses:notices": "node licenses/notices.ts"
  },
  "devDependencies": {
    "@terrazzo/cli": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "colorjs.io": "catalog:",
    "motion": "catalog:",
    "style-dictionary": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
