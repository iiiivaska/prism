{
  "name": "@iiiivaska/prism-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build and check tooling: DTCG schema validation, token build (Style Dictionary 5 + resolver driver), Terrazzo lint and orthogonality, source normalizer, contrast, token diff, font check, spec validation, icon registry validation, parity report, gallery pairing, license gate, notices, literal-values guard, reference-copy guard",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:literals": "node lint/literals.ts",
    "lint:reference-copy": "node lint/reference-copy.ts",
    "tokens:validate": "node tokens/validate.ts",
    "tokens:lint": "tz lint --config tokens/terrazzo.config.ts && node tokens/lint-orthogonality.ts",
    "tokens:normalize": "node tokens/normalize.ts --write",
    "tokens:normalize:check": "node tokens/normalize.ts --check",
    "tokens:build": "node tokens/build.ts",
    "tokens:check": "node tokens/build.ts --check",
    "tokens:diff": "node tokens/diff.ts",
    "contrast:check": "node contrast/check.ts",
    "fonts:check": "node fonts/check.ts",
    "spec:validate": "node spec/validate.ts",
    "icons:validate": "node icons/validate.ts",
    "icons:build": "node icons/validate.ts --write",
    "parity:report": "node parity/report.ts",
    "gallery:build": "node gallery/build.ts",
    "release:plan": "node release/stamp.ts --plan",
    "release:stamp": "node release/stamp.ts",
    "release:check": "node release/stamp.ts --check",
    "release:pack": "node release/pack.ts",
    "fixtures:web": "node release/fixture-web.ts",
    "fixtures:apple": "node release/fixture-apple.ts",
    "showcase:apple": "node showcase/apple/run.ts",
    "showcase:apple:generate": "node showcase/apple/run.ts --generate",
    "licenses:check": "node licenses/check.ts",
    "licenses:notices": "node licenses/notices.ts"
  },
  "devDependencies": {
    "@phosphor-icons/core": "catalog:",
    "@tailwindcss/node": "catalog:",
    "@terrazzo/cli": "catalog:",
    "@terrazzo/parser": "catalog:",
    "@tokens-studio/types": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "colorjs.io": "catalog:",
    "jsonc-parser": "catalog:",
    "motion": "catalog:",
    "opentype.js": "catalog:",
    "style-dictionary": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "woff2-encoder": "catalog:",
    "yaml": "catalog:"
  }
}
