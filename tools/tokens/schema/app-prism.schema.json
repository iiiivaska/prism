{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prism.local/schema/app-prism.schema.json",
  "title": "$extensions[\"app.prism\"] of a Prism token",
  "description": "Unknown keys are errors. Functional keys (spring, slot, numeric, textStyle, darkWeight, opsz, flag, angle, grain, scheme, bloom) are declared on literal tokens only; alpha on sys color aliases only (tools/tokens/ARCHITECTURE.md §5.4, ADR-0020 §3, ADR-0021, ADR-0022, ADR-0023, ADR-0024 §4). There are no material keys and no text-safe-zone key (ADR-0022).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spring": {
      "description": "Apple two-parameter spring on a transition token with a literal $value (ADR-0023 §1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "bounce"],
      "properties": {
        "duration": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "bounce": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "blendDuration": { "type": "number", "minimum": 0, "maximum": 1 },
        "settle": { "type": "number", "minimum": 0 }
      }
    },
    "slot": { "enum": ["ui", "display", "mono"] },
    "numeric": { "enum": ["proportional", "tabular"] },
    "textStyle": {
      "enum": ["largeTitle", "title", "title2", "title3", "headline", "body", "callout", "subheadline", "footnote", "caption", "caption2"]
    },
    "darkWeight": { "enum": [100, 200] },
    "opsz": { "type": "number", "exclusiveMinimum": 0 },
    "flag": { "type": "boolean" },
    "angle": { "type": "number" },
    "grain": { "type": "number", "minimum": 0, "maximum": 1 },
    "scheme": { "enum": ["light", "dark"] },
    "bloom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha"],
      "properties": {
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "blur": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pairsWith": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "minContrast": { "type": "number", "minimum": 1 }
      }
    },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "codeSyntax": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usage": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "string" }
      }
    },
    "brand": { "type": "string" }
  }
}
