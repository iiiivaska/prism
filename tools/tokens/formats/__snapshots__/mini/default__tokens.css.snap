/* Generated by tools/tokens from tokens/prism.resolver.json (brand "default", platform "web"). Do not edit; run `pnpm tokens:build`. */
@layer ds.tokens {
  /* invariant */
  :root {
    --ds-ref-color-accent-300: oklch(0.8506 0.1133 68.21);
    --ds-ref-color-accent-500: oklch(0.7517 0.1475 57.6);
    --ds-ref-color-accent-800: oklch(0.4981 0.1107 47.3);
    --ds-ref-color-neutral-0: oklch(1 0 0);
    --ds-ref-color-neutral-100: oklch(0.9612 0.0041 271.4);
    --ds-ref-color-neutral-900: oklch(0.2213 0.0072 271.4);
    --ds-ref-color-neutral-950: oklch(0.1693 0.0061 271.4);
    --ds-ref-color-slot-dark-bg-fill-accent: var(--ds-ref-color-accent-500);
    --ds-ref-color-slot-dark-bg-page: var(--ds-ref-color-neutral-950);
    --ds-ref-color-slot-dark-text-accent: var(--ds-ref-color-accent-500);
    --ds-ref-color-slot-dark-text-on-accent: var(--ds-ref-color-neutral-950);
    --ds-ref-color-slot-light-bg-fill-accent: var(--ds-ref-color-accent-300);
    --ds-ref-color-slot-light-bg-page: var(--ds-ref-color-neutral-100);
    --ds-ref-color-slot-light-text-accent: var(--ds-ref-color-accent-800);
    --ds-ref-color-slot-light-text-on-accent: var(--ds-ref-color-neutral-950);
    --ds-ref-font-display: "Onest", system-ui, sans-serif;
    --ds-ref-font-ui: "Onest", system-ui, sans-serif;
    --ds-ref-gradient-vivid-plum-dusk: linear-gradient(200deg in oklab, oklch(0.45 0.09 330) 0%, oklch(0.3 0.06 300) 100%);
    --ds-ref-gradient-vivid-plum-dusk-bloom-alpha: 0;
    --ds-ref-gradient-vivid-plum-dusk-bloom-blur: 0px;
    --ds-ref-gradient-vivid-plum-dusk-bloom-color: oklch(0.45 0.09 330);
    --ds-ref-gradient-vivid-plum-dusk-grain: 0.05;
    --ds-ref-gradient-vivid-sky: linear-gradient(165deg in oklab, oklch(0.6 0.12 240) 0%, oklch(0.42 0.1 250) 100%);
    --ds-ref-gradient-vivid-sky-bloom-alpha: 0.3;
    --ds-ref-gradient-vivid-sky-bloom-blur: 150px;
    --ds-ref-gradient-vivid-sky-bloom-color: oklch(0.6 0.12 240);
    --ds-ref-gradient-vivid-sky-grain: 0.06;
    --ds-ref-space-2: 8px;
    --ds-ref-space-4: 16px;
    --ds-ref-type-body-md-font-family: var(--ds-ref-font-ui);
    --ds-ref-type-body-md-font-size: 0.9375rem;
    --ds-ref-type-body-md-font-variant-numeric: normal;
    --ds-ref-type-body-md-font-weight: 400;
    --ds-ref-type-body-md-letter-spacing: 0em;
    --ds-ref-type-body-md-line-height: 1.5;
    --ds-ref-type-metric-xl-font-family: var(--ds-ref-font-display);
    --ds-ref-type-metric-xl-font-size: 3rem;
    --ds-ref-type-metric-xl-font-variant-numeric: normal;
    --ds-ref-type-metric-xl-letter-spacing: -0.02em;
    --ds-ref-type-metric-xl-line-height: 1;
    --ds-ref-type-scale: 1;
    --ds-type-body-md-font-family: var(--ds-ref-type-body-md-font-family);
    --ds-type-body-md-font-size: var(--ds-ref-type-body-md-font-size);
    --ds-type-body-md-font-variant-numeric: var(--ds-ref-type-body-md-font-variant-numeric);
    --ds-type-body-md-font-weight: var(--ds-ref-type-body-md-font-weight);
    --ds-type-body-md-letter-spacing: var(--ds-ref-type-body-md-letter-spacing);
    --ds-type-body-md-line-height: var(--ds-ref-type-body-md-line-height);
    --ds-type-metric-xl-font-family: var(--ds-ref-type-metric-xl-font-family);
    --ds-type-metric-xl-font-size: var(--ds-ref-type-metric-xl-font-size);
    --ds-type-metric-xl-font-variant-numeric: var(--ds-ref-type-metric-xl-font-variant-numeric);
    --ds-type-metric-xl-letter-spacing: var(--ds-ref-type-metric-xl-letter-spacing);
    --ds-type-metric-xl-line-height: var(--ds-ref-type-metric-xl-line-height);
    --ds-card-title-font-family: var(--ds-type-metric-xl-font-family);
    --ds-card-title-font-size: var(--ds-type-metric-xl-font-size);
    --ds-card-title-font-variant-numeric: var(--ds-type-metric-xl-font-variant-numeric);
    --ds-card-title-letter-spacing: var(--ds-type-metric-xl-letter-spacing);
    --ds-card-title-line-height: var(--ds-type-metric-xl-line-height);
  }
  @media (color-gamut: p3) {
    :root {
      --ds-ref-color-accent-300: oklch(0.8506 0.1133 68.2);
    }
  }
  /* colorScheme: light (default) */
  :root,
  [data-ds-color-scheme="light"] {
    color-scheme: light;
    --ds-ref-type-metric-xl-font-weight: 300;
    --ds-color-bg-fill-accent: var(--ds-ref-color-slot-light-bg-fill-accent);
    --ds-color-bg-page: var(--ds-ref-color-slot-light-bg-page);
    --ds-color-bg-surface: var(--ds-ref-color-neutral-0);
    --ds-color-bg-surface-raised: var(--ds-ref-color-neutral-0);
    --ds-color-bg-tint-accent: oklch(0.7517 0.1475 57.6 / 0.12);
    --ds-color-text-accent: var(--ds-ref-color-slot-light-text-accent);
    --ds-color-text-on-accent: var(--ds-ref-color-slot-light-text-on-accent);
    --ds-color-text-primary: var(--ds-ref-color-neutral-900);
    --ds-color-text-secondary: rgb(0 0 0 / 0.64);
    --ds-gradient-vivid-default: var(--ds-ref-gradient-vivid-sky);
    --ds-gradient-vivid-default-bloom-alpha: var(--ds-ref-gradient-vivid-sky-bloom-alpha);
    --ds-gradient-vivid-default-bloom-blur: var(--ds-ref-gradient-vivid-sky-bloom-blur);
    --ds-gradient-vivid-default-bloom-color: var(--ds-ref-gradient-vivid-sky-bloom-color);
    --ds-gradient-vivid-default-grain: var(--ds-ref-gradient-vivid-sky-grain);
  }
  /* colorScheme: dark */
  [data-ds-color-scheme="dark"] {
    color-scheme: dark;
    --ds-ref-type-metric-xl-font-weight: 200;
    --ds-color-bg-fill-accent: var(--ds-ref-color-slot-dark-bg-fill-accent);
    --ds-color-bg-page: var(--ds-ref-color-slot-dark-bg-page);
    --ds-color-bg-surface: var(--ds-ref-color-neutral-900);
    --ds-color-bg-surface-raised: var(--ds-ref-color-neutral-900);
    --ds-color-bg-tint-accent: oklch(0.7517 0.1475 57.6 / 0.14);
    --ds-color-text-accent: var(--ds-ref-color-slot-dark-text-accent);
    --ds-color-text-on-accent: var(--ds-ref-color-slot-dark-text-on-accent);
    --ds-color-text-primary: var(--ds-ref-color-neutral-0);
    --ds-color-text-secondary: rgb(255 255 255 / 0.64);
    --ds-gradient-vivid-default: var(--ds-ref-gradient-vivid-plum-dusk);
    --ds-gradient-vivid-default-bloom-alpha: var(--ds-ref-gradient-vivid-plum-dusk-bloom-alpha);
    --ds-gradient-vivid-default-bloom-blur: var(--ds-ref-gradient-vivid-plum-dusk-bloom-blur);
    --ds-gradient-vivid-default-bloom-color: var(--ds-ref-gradient-vivid-plum-dusk-bloom-color);
    --ds-gradient-vivid-default-grain: var(--ds-ref-gradient-vivid-plum-dusk-grain);
  }
  /* colorScheme: dark under (prefers-color-scheme: dark) without a valid data-ds-color-scheme */
  @media (prefers-color-scheme: dark) {
    :root:not([data-ds-color-scheme="light"], [data-ds-color-scheme="dark"]) {
      color-scheme: dark;
      --ds-ref-type-metric-xl-font-weight: 200;
      --ds-color-bg-fill-accent: var(--ds-ref-color-slot-dark-bg-fill-accent);
      --ds-color-bg-page: var(--ds-ref-color-slot-dark-bg-page);
      --ds-color-bg-surface: var(--ds-ref-color-neutral-900);
      --ds-color-bg-surface-raised: var(--ds-ref-color-neutral-900);
      --ds-color-bg-tint-accent: oklch(0.7517 0.1475 57.6 / 0.14);
      --ds-color-text-accent: var(--ds-ref-color-slot-dark-text-accent);
      --ds-color-text-on-accent: var(--ds-ref-color-slot-dark-text-on-accent);
      --ds-color-text-primary: var(--ds-ref-color-neutral-0);
      --ds-color-text-secondary: rgb(255 255 255 / 0.64);
      --ds-gradient-vivid-default: var(--ds-ref-gradient-vivid-plum-dusk);
      --ds-gradient-vivid-default-bloom-alpha: var(--ds-ref-gradient-vivid-plum-dusk-bloom-alpha);
      --ds-gradient-vivid-default-bloom-blur: var(--ds-ref-gradient-vivid-plum-dusk-bloom-blur);
      --ds-gradient-vivid-default-bloom-color: var(--ds-ref-gradient-vivid-plum-dusk-bloom-color);
      --ds-gradient-vivid-default-grain: var(--ds-ref-gradient-vivid-plum-dusk-grain);
    }
  }
  /* colorScheme rescope: same text in every context, value depends on colorScheme */
  :root,
  [data-ds-color-scheme] {
    --ds-type-metric-xl-font-weight: var(--ds-ref-type-metric-xl-font-weight);
    --ds-button-bg: var(--ds-color-bg-tint-accent);
    --ds-card-bg: var(--ds-color-bg-surface);
    --ds-card-title-font-weight: var(--ds-type-metric-xl-font-weight);
  }
  /* density: compact (default) */
  :root,
  [data-ds-density="compact"] {
    --ds-size-control-md: 32px;
    --ds-space-card-padding: var(--ds-ref-space-2);
  }
  /* density: regular */
  [data-ds-density="regular"] {
    --ds-size-control-md: 40px;
    --ds-space-card-padding: var(--ds-ref-space-4);
  }
  /* density: comfortable */
  [data-ds-density="comfortable"] {
    --ds-size-control-md: 48px;
    --ds-space-card-padding: var(--ds-ref-space-4);
  }
  /* density: regular under (any-pointer: coarse) without a valid data-ds-density */
  @media (any-pointer: coarse) {
    :root:not([data-ds-density="compact"], [data-ds-density="regular"], [data-ds-density="comfortable"], [data-ds-density="watch"]) {
      --ds-size-control-md: 40px;
      --ds-space-card-padding: var(--ds-ref-space-4);
    }
  }
}
