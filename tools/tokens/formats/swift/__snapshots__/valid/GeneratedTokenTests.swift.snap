    @Test func altColors() {
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt))
            check(DSColor(brand: .alt, transparency: .standard).bgFillAccent, Color("alt/color-bg-fill-accent", bundle: DSTokensBundle.bundle), "alt: color.bgFillAccent")
            check(DSColor(brand: .alt, transparency: .standard).bgPage, Color("alt/color-bg-page", bundle: DSTokensBundle.bundle), "alt: color.bgPage")
            check(DSColor(brand: .alt, transparency: .standard).bgSurface, Color("alt/color-bg-surface", bundle: DSTokensBundle.bundle), "alt: color.bgSurface")
            check(DSColor(brand: .alt, transparency: .standard).bgSurfaceRaised, Color("alt/color-bg-surface-raised", bundle: DSTokensBundle.bundle), "alt: color.bgSurfaceRaised")
            check(DSColor(brand: .alt, transparency: .standard).bgTintAccent, Color("alt/color-bg-tint-accent", bundle: DSTokensBundle.bundle), "alt: color.bgTintAccent")
            check(DSColor(brand: .alt, transparency: .standard).borderHairline, Color("alt/color-border-hairline", bundle: DSTokensBundle.bundle), "alt: color.borderHairline")
            check(DSColor(brand: .alt, transparency: .standard).textAccent, Color("alt/color-text-accent", bundle: DSTokensBundle.bundle), "alt: color.textAccent")
