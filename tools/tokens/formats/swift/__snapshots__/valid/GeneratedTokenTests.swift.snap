        do {
            let t = DSTokenSet(DSTokenContext(brand: .prism, density: .comfortable))
            check(t.space.cardPadding, 16, "prism density=comfortable: space.cardPadding")
            check(t.size.controlMd, 32, "prism density=comfortable: size.controlMd")
        }
    }

