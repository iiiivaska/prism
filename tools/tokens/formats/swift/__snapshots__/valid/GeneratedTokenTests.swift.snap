    @Test func altCatalog() {
        check(DSColorToken.bgFillAccent.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.9622, 0.7628, 0.5194, 1), dark: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 1), highContrast: DSRGBA(.displayP3, 0.9622, 0.7628, 0.5194, 1), darkHighContrast: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 1), watch: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 1)), "alt: color-bg-fill-accent")
        check(DSColorToken.bgFillAccent.assetName(.alt), "alt/color-bg-fill-accent", "alt: color-bg-fill-accent asset name")
        check(DSColorToken.bgPage.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.9458, 0.9488, 0.9595, 1), dark: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1), highContrast: DSRGBA(.displayP3, 0.9458, 0.9488, 0.9595, 1), darkHighContrast: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1), watch: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1)), "alt: color-bg-page")
        check(DSColorToken.bgPage.assetName(.alt), "alt/color-bg-page", "alt: color-bg-page asset name")
        check(DSColorToken.bgSurface.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 1, 1, 1, 1), dark: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1), highContrast: DSRGBA(.displayP3, 1, 1, 1, 1), darkHighContrast: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1), watch: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1)), "alt: color-bg-surface")
        check(DSColorToken.bgSurface.assetName(.alt), "alt/color-bg-surface", "alt: color-bg-surface asset name")
        check(DSColorToken.bgSurfaceRaised.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 1, 1, 1, 1), dark: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1), highContrast: DSRGBA(.displayP3, 1, 1, 1, 1), darkHighContrast: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1), watch: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1)), "alt: color-bg-surface-raised")
        check(DSColorToken.bgSurfaceRaised.assetName(.alt), "alt/color-bg-surface-raised", "alt: color-bg-surface-raised asset name")
        check(DSColorToken.bgTintAccent.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 0.12), dark: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 0.14), highContrast: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 0.12), darkHighContrast: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 0.14), watch: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 0.14)), "alt: color-bg-tint-accent")
        check(DSColorToken.bgTintAccent.assetName(.alt), "alt/color-bg-tint-accent", "alt: color-bg-tint-accent asset name")
        check(DSColorToken.borderHairline.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 0.1), dark: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 0.12), highContrast: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 0.3), darkHighContrast: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 0.12), watch: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 0.12)), "alt: color-border-hairline")
        check(DSColorToken.borderHairline.assetName(.alt), "alt/color-border-hairline", "alt: color-border-hairline asset name")
        check(DSColorToken.textAccent.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.5444, 0.3127, 0.1766, 1), dark: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 1), highContrast: DSRGBA(.displayP3, 0.4054, 0.2226, 0.1258, 1), darkHighContrast: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 1), watch: DSRGBA(.displayP3, 0.2808, 0.6219, 0.3278, 1)), "alt: color-text-accent")
        check(DSColorToken.textAccent.assetName(.alt), "alt/color-text-accent", "alt: color-text-accent asset name")
        check(DSColorToken.textOnAccent.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1), dark: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1), highContrast: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1), darkHighContrast: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1), watch: DSRGBA(.displayP3, 0.0564, 0.0592, 0.0695, 1)), "alt: color-text-on-accent")
        check(DSColorToken.textOnAccent.assetName(.alt), "alt/color-text-on-accent", "alt: color-text-on-accent asset name")
        check(DSColorToken.textOnGlass.appearances(.alt), DSColorAppearances(any: DSRGBA(.sRGB, 1, 1, 1, 1), dark: DSRGBA(.sRGB, 1, 1, 1, 1), highContrast: DSRGBA(.sRGB, 1, 1, 1, 1), darkHighContrast: DSRGBA(.sRGB, 1, 1, 1, 1), watch: DSRGBA(.sRGB, 1, 1, 1, 1)), "alt: color-text-on-glass")
        check(DSColorToken.textOnGlass.assetName(.alt), "alt/color-text-on-glass", "alt: color-text-on-glass asset name")
        check(DSColorToken.textPrimary.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1), dark: DSRGBA(.displayP3, 1, 1, 1, 1), highContrast: DSRGBA(.displayP3, 0.1011, 0.1047, 0.1177, 1), darkHighContrast: DSRGBA(.displayP3, 1, 1, 1, 1), watch: DSRGBA(.displayP3, 1, 1, 1, 1)), "alt: color-text-primary")
        check(DSColorToken.textPrimary.assetName(.alt), "alt/color-text-primary", "alt: color-text-primary asset name")
        check(DSColorToken.textSecondary.appearances(.alt), DSColorAppearances(any: DSRGBA(.sRGB, 0, 0, 0, 0.64), dark: DSRGBA(.sRGB, 1, 1, 1, 0.64), highContrast: DSRGBA(.sRGB, 0, 0, 0, 0.8), darkHighContrast: DSRGBA(.sRGB, 1, 1, 1, 0.8), watch: DSRGBA(.sRGB, 1, 1, 1, 0.64)), "alt: color-text-secondary")
        check(DSColorToken.textSecondary.assetName(.alt), "alt/color-text-secondary", "alt: color-text-secondary asset name")
        check(DSColorToken.materialGlassDarkFill.appearances(.alt), DSColorAppearances(any: DSRGBA(.displayP3, 0.0407, 0.0469, 0.0328, 0.55), dark: DSRGBA(.displayP3, 0.0657, 0.078, 0.0639, 0.6), highContrast: DSRGBA(.displayP3, 0.0407, 0.0469, 0.0328, 0.55), darkHighContrast: DSRGBA(.displayP3, 0.0657, 0.078, 0.0639, 0.6), watch: DSRGBA(.displayP3, 0.0657, 0.078, 0.0639, 0.6)), "alt: material-glass-dark-fill")
        check(DSColorToken.materialGlassDarkFill.assetName(.alt), "alt/material-glass-dark-fill", "alt: material-glass-dark-fill asset name")
        check(DSColorToken.materialGlassScrim.appearances(.alt), DSColorAppearances(any: DSRGBA(.sRGB, 0, 0, 0, 0.35), dark: DSRGBA(.sRGB, 0, 0, 0, 0.4), highContrast: DSRGBA(.sRGB, 0, 0, 0, 0.35), darkHighContrast: DSRGBA(.sRGB, 0, 0, 0, 0.4), watch: DSRGBA(.sRGB, 0, 0, 0, 0.4)), "alt: material-glass-scrim")
        check(DSColorToken.materialGlassScrim.assetName(.alt), "alt/material-glass-scrim", "alt: material-glass-scrim asset name")
        check(DSBrand.alt.faces, [.display: DSFontFace(families: ["system-ui"], file: nil, postScriptNames: [:], opticalSize: nil, system: .`default`), .mono: DSFontFace(families: ["ui-monospace"], file: nil, postScriptNames: [:], opticalSize: nil, system: .monospaced), .ui: DSFontFace(families: ["system-ui"], file: nil, postScriptNames: [:], opticalSize: nil, system: .`default`)], "alt: faces")
        check(DSBrand.alt.colorNamespace, "alt", "alt: colorNamespace")
        check(DSBrand.alt.preset, .native, "alt: preset")
    }

    @Test func springCurves() {
        checkSpring(DSTokenSet(DSTokenContext(brand: .prism)).motion.springInteractive, [(0.022, 0.2354), (0.055, 0.67), (0.11, 0.9441), (0.165, 0.9921), (0.22, 0.999)], "prism: motion.springInteractive (0.15, 0)")
        checkSpring(DSTokenSet(DSTokenContext(brand: .prism)).motion.springSnappy, [(0.0487, 0.2328), (0.12175, 0.7065), (0.2435, 0.9871), (0.36525, 1.0055), (0.487, 1.001)], "prism: motion.springSnappy (0.35, 0.15)")
        checkSpring(DSTokenSet(DSTokenContext(brand: .prism, motion: .reduced)).motion.springSnappy, [(0.0367, 0.2357), (0.09175, 0.6705), (0.1835, 0.9443), (0.27525, 0.9922), (0.367, 0.999)], "prism motion=reduced: motion.springSnappy (0.25, 0)")
    }

    @Test func platformDefault() {
#if os(watchOS)
        check(DSTokenContext.platformDefault, DSTokenContext(colorScheme: .dark, density: .comfortable, modality: .touch), "watchos platformDefault")
#elseif os(macOS)
        check(DSTokenContext.platformDefault, DSTokenContext(density: .compact, modality: .pointer), "macos platformDefault")
#else
        check(DSTokenContext.platformDefault, DSTokenContext(density: .regular, modality: .touch), "ios platformDefault")
#endif
    }
}
