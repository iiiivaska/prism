    @Test func altDensity() {
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt))
            check(t.space.cardPadding, 16, "alt: space.cardPadding")
            check(t.size.controlMd, 32, "alt: size.controlMd")
        }
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt, density: .regular))
            check(t.space.cardPadding, 24, "alt density=regular: space.cardPadding")
            check(t.size.controlMd, 40, "alt density=regular: size.controlMd")
        }
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt, density: .comfortable))
            check(t.space.cardPadding, 16, "alt density=comfortable: space.cardPadding")
            check(t.size.controlMd, 32, "alt density=comfortable: size.controlMd")
        }
    }

    @Test func altModality() {
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt))
            check(t.size.hit, 28, "alt: size.hit")
            check(t.interaction.hover, true, "alt: interaction.hover")
        }
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt, modality: .touch))
            check(t.size.hit, 44, "alt modality=touch: size.hit")
            check(t.interaction.hover, false, "alt modality=touch: interaction.hover")
        }
    }

    @Test func altMotion() {
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt))
            check(t.motion.durationBase, 0.25, "alt: motion.durationBase")
            check(t.motion.durationFast, 0.15, "alt: motion.durationFast")
            check(t.motion.presentationCrossfade, false, "alt: motion.presentationCrossfade")
            check(t.motion.springSnappy, DSSpringToken(duration: 0.35, bounce: 0.15, blendDuration: 0, settle: 0.487, mass: 1, stiffness: 322.2728, damping: 30.5183), "alt: motion.springSnappy")
            check(t.components.button.motionPress, DSSpringToken(duration: 0.35, bounce: 0.15, blendDuration: 0, settle: 0.487, mass: 1, stiffness: 322.2728, damping: 30.5183), "alt: components.button.motionPress")
        }
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt, motion: .reduced))
            check(t.motion.durationBase, 0.15, "alt motion=reduced: motion.durationBase")
            check(t.motion.durationFast, 0.1, "alt motion=reduced: motion.durationFast")
            check(t.motion.presentationCrossfade, true, "alt motion=reduced: motion.presentationCrossfade")
            check(t.motion.springSnappy, DSSpringToken(duration: 0.25, bounce: 0, blendDuration: 0, settle: 0.367, mass: 1, stiffness: 631.6547, damping: 50.2655), "alt motion=reduced: motion.springSnappy")
            check(t.components.button.motionPress, DSSpringToken(duration: 0.25, bounce: 0, blendDuration: 0, settle: 0.367, mass: 1, stiffness: 631.6547, damping: 50.2655), "alt motion=reduced: components.button.motionPress")
        }
    }

    @Test func altTypeWeights() {
        do {
            let t = DSTokenSet(DSTokenContext(brand: .alt))
            check(t.typography.bodyMd.weight, 400, "alt: typography.bodyMd.weight")
