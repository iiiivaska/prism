        do {
            let t = DSTokenSet(DSTokenContext(brand: .prism, density: .regular))
            check(t.space.cardPadding, 24, "prism density=regular: space.cardPadding")
            check(t.size.controlMd, 40, "prism density=regular: size.controlMd")
