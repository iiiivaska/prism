            let t = DSTokenSet(DSTokenContext(brand: .prism))
            check(t.size.hit, 28, "prism: size.hit")
            check(t.interaction.hover, true, "prism: interaction.hover")
        }
        do {
            let t = DSTokenSet(DSTokenContext(brand: .prism, modality: .touch))
            check(t.size.hit, 44, "prism modality=touch: size.hit")
            check(t.interaction.hover, false, "prism modality=touch: interaction.hover")
        }
    }

    @Test func prismMotion() {
        do {
            let t = DSTokenSet(DSTokenContext(brand: .prism))
            check(t.motion.durationBase, 0.25, "prism: motion.durationBase")
            check(t.motion.durationFast, 0.15, "prism: motion.durationFast")
            check(t.motion.presentationCrossfade, false, "prism: motion.presentationCrossfade")
            check(t.motion.springSnappy, DSSpringToken(duration: 0.35, bounce: 0.15, blendDuration: 0, settle: 0.487, mass: 1, stiffness: 322.2728, damping: 30.5183), "prism: motion.springSnappy")
            check(t.components.button.motionPress, DSSpringToken(duration: 0.35, bounce: 0.15, blendDuration: 0, settle: 0.487, mass: 1, stiffness: 322.2728, damping: 30.5183), "prism: components.button.motionPress")
        }
        do {
            let t = DSTokenSet(DSTokenContext(brand: .prism, motion: .reduced))
            check(t.motion.durationBase, 0.15, "prism motion=reduced: motion.durationBase")
            check(t.motion.durationFast, 0.1, "prism motion=reduced: motion.durationFast")
            check(t.motion.presentationCrossfade, true, "prism motion=reduced: motion.presentationCrossfade")
            check(t.motion.springSnappy, DSSpringToken(duration: 0.25, bounce: 0, blendDuration: 0, settle: 0.367, mass: 1, stiffness: 631.6547, damping: 50.2655), "prism motion=reduced: motion.springSnappy")
            check(t.components.button.motionPress, DSSpringToken(duration: 0.25, bounce: 0, blendDuration: 0, settle: 0.367, mass: 1, stiffness: 631.6547, damping: 50.2655), "prism motion=reduced: components.button.motionPress")
        }
    }

