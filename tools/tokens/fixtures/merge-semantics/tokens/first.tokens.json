{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "$description": "first",
    "color": {
      "$type": "color",
      "$description": "first colors",
      "brand": {
        "$value": { "colorSpace": "oklch", "components": [0.7517, 0.1475, 57.6], "alpha": 1, "hex": "#f39444" },
        "$description": "declared first",
        "$extensions": { "app.prism": { "a11y": { "pairsWith": ["ref.color.paper"] } } }
      },
      "paper": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" } }
    },
    "elevation": {
      "$type": "shadow",
      "card": {
        "$value": [
          { "color": "{ref.color.brand}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
          { "color": "{ref.color.brand}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 16, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
        ]
      }
    }
  }
}
