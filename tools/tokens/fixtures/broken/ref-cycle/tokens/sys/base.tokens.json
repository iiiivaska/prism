{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "type": {
      "body": {
        "md": {
          "$type": "typography",
          "$value": "{ref.type.body.md}"
        }
      },
      "label": {
        "sm": {
          "$type": "typography",
          "$value": "{ref.type.label.sm}"
        }
      },
      "metric": {
        "xl": {
          "$type": "typography",
          "$value": "{ref.type.metric.xl}"
        }
      },
      "code": {
        "md": {
          "$type": "typography",
          "$value": "{ref.type.code.md}"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{sys.radius.alt}"
      },
      "alt": {
        "$value": "{sys.radius.card}"
      }
    },
    "border": {
      "$type": "dimension",
      "hairline": {
        "$value": "{ref.border.hairline}"
      }
    }
  }
}
