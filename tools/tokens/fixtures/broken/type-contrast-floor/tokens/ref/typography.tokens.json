{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "font": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "Onest",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Web stack of the ui slot: served families and CSS generics only (ADR-0020)"
      },
      "display": {
        "$value": [
          "Onest",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ]
      },
      "apple": {
        "ui": {
          "$value": [
            "Onest"
          ]
        },
        "display": {
          "$value": [
            "Onest"
          ]
        },
        "mono": {
          "$value": [
            "JetBrains Mono"
          ]
        }
      }
    },
    "type": {
      "$type": "typography",
      "scale": {
        "$type": "number",
        "$value": 1,
        "$description": "Brand type-scale multiplier"
      },
      "body": {
        "md": {
          "$value": {
            "fontFamily": "{ref.font.ui}",
            "fontSize": {
              "value": 15,
              "unit": "px"
            },
            "fontWeight": 400,
            "lineHeight": 1.5,
            "letterSpacing": {
              "value": 0,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "ui",
              "numeric": "proportional",
              "textStyle": "subheadline"
            }
          }
        }
      },
      "label": {
        "sm": {
          "$value": {
            "fontFamily": "{ref.font.ui}",
            "fontSize": {
              "value": 12,
              "unit": "px"
            },
            "fontWeight": 500,
            "lineHeight": 1.33,
            "letterSpacing": {
              "value": 0.12,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "ui",
              "numeric": "proportional",
              "textStyle": "caption"
            }
          }
        }
      },
      "metric": {
        "xl": {
          "$value": {
            "fontFamily": "{ref.font.display}",
            "fontSize": {
              "value": 48,
              "unit": "px"
            },
            "fontWeight": 300,
            "lineHeight": 1,
            "letterSpacing": {
              "value": -0.96,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "display",
              "numeric": "proportional",
              "textStyle": "largeTitle",
              "darkWeight": 200
            }
          }
        }
      },
      "code": {
        "md": {
          "$value": {
            "fontFamily": "{ref.font.mono}",
            "fontSize": {
              "value": 13,
              "unit": "px"
            },
            "fontWeight": 500,
            "lineHeight": 1.4,
            "letterSpacing": {
              "value": 0,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "mono",
              "numeric": "tabular",
              "textStyle": "footnote"
            }
          }
        }
      },
      "weight": {
        "light": {
          "$type": "fontWeight",
          "$value": 300
        }
      }
    }
  }
}
