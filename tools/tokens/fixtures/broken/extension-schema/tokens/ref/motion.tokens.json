{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "out": {
          "$value": [
            0.23,
            1,
            0.32,
            1
          ]
        },
        "in-out": {
          "$value": [
            0.77,
            0,
            0.175,
            1
          ]
        }
      },
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": {
            "value": 150,
            "unit": "ms"
          }
        },
        "base": {
          "$value": {
            "value": 250,
            "unit": "ms"
          }
        }
      },
      "spring": {
        "$type": "transition",
        "interactive": {
          "$value": {
            "duration": {
              "value": 220,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 150,
                "bounce": 0,
                "settle": 0.22,
                "blendDuration": 0.25
              },
              "blur": 12
            }
          }
        },
        "snappy": {
          "$value": {
            "duration": {
              "value": 487,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.35,
                "bounce": 0.15,
                "settle": 0.487
              }
            }
          }
        }
      }
    }
  }
}
