{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "bg": {
        "page": {
          "$value": "{ref.color.slot.dark.bg-page}"
        },
        "surface": {
          "$root": {
            "$value": "{ref.color.neutral.900}"
          },
          "raised": {
            "$value": "{ref.color.neutral.900}"
          }
        },
        "fill": {
          "accent": {
            "$value": "{ref.color.slot.dark.bg-fill-accent}"
          }
        },
        "tint": {
          "accent": {
            "$value": "{ref.color.accent.500}",
            "$extensions": {
              "app.prism": {
                "alpha": 0.14
              }
            }
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{ref.color.neutral.0}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface"
                ]
              }
            }
          }
        },
        "secondary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.64,
            "hex": "#ffffff"
          }
        },
        "on-accent": {
          "$value": "{ref.color.slot.dark.text-on-accent}"
        },
        "accent": {
          "$value": "{ref.color.slot.dark.text-accent}"
        },
        "on-glass": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "border": {
        "hairline": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "alpha": 0.12
            }
          }
        }
      }
    },
    "material": {
      "glass": {
        "dark": {
          "fill": {
            "$root": {
              "$type": "color",
              "$value": "{ref.color.smoke.dark}",
              "$extensions": {
                "app.prism": {
                  "alpha": 0.6
                }
              }
            },
            "blur": {
              "$type": "dimension",
              "$value": "{ref.blur.chip}"
            },
            "saturate": {
              "$type": "number",
              "$value": 1.2
            },
            "edge": {
              "start": {
                "$type": "number",
                "$value": 0.15
              },
              "end": {
                "$type": "number",
                "$value": 0
              }
            },
            "grain": {
              "$type": "number",
              "$value": 0
            },
            "bloom": {
              "$type": "number",
              "$value": 0
            }
          }
        },
        "scrim": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.4,
            "hex": "#000000"
          }
        }
      }
    },
    "elevation": {
      "1": {
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.3,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 6,
            "unit": "px"
          },
          "blur": {
            "value": 16,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "$type": "shadow"
    },
    "gradient": {
      "$type": "gradient",
      "vivid": {
        "default": {
          "$value": "{ref.gradient.vivid.plum-dusk}"
        }
      }
    }
  }
}
