{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "type": {
      "body": {
        "md": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{ref.font.ui}",
            "fontSize": {
              "value": 15,
              "unit": "px"
            },
            "fontWeight": 400,
            "lineHeight": 1.5,
            "letterSpacing": {
              "value": 0,
              "unit": "px"
            }
          }
        }
      },
      "label": {
        "sm": {
          "$type": "typography",
          "$value": "{ref.type.label.sm}"
        }
      },
      "metric": {
        "xl": {
          "$type": "typography",
          "$value": "{ref.type.metric.xl}"
        }
      },
      "code": {
        "md": {
          "$type": "typography",
          "$value": "{ref.type.code.md}"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{ref.radius.2}"
      }
    },
    "border": {
      "$type": "dimension",
      "hairline": {
        "$value": "{ref.border.hairline}"
      }
    }
  }
}
