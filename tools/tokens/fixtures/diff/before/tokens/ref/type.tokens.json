{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "font": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "Onest",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Onest",
          "system-ui",
          "sans-serif"
        ],
        "$extensions": {
          "app.prism": {
            "opsz": 32
          }
        }
      }
    },
    "type": {
      "$type": "typography",
      "scale": {
        "$type": "number",
        "$value": 1
      },
      "body": {
        "md": {
          "$value": {
            "fontFamily": "{ref.font.ui}",
            "fontSize": {
              "value": 15,
              "unit": "px"
            },
            "fontWeight": 400,
            "lineHeight": 1.5,
            "letterSpacing": {
              "value": 0,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "ui",
              "numeric": "proportional",
              "textStyle": "subheadline"
            }
          }
        }
      },
      "metric": {
        "xl": {
          "$value": {
            "fontFamily": "{ref.font.display}",
            "fontSize": {
              "value": 48,
              "unit": "px"
            },
            "fontWeight": 300,
            "lineHeight": 1,
            "letterSpacing": {
              "value": -0.96,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "display",
              "numeric": "proportional",
              "textStyle": "largeTitle",
              "darkWeight": 200
            }
          },
          "$description": "the one hero numeral; 300 in light, 200 in dark"
        }
      }
    }
  }
}
