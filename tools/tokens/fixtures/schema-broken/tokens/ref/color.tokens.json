{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "color": {
      "$type": "color",
      "ok": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0.1, 250],
          "alpha": 1,
          "hex": "#32669a"
        }
      },
      "two-components": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0.1],
          "alpha": 1
        }
      }
    }
  }
}
