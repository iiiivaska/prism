{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "bg": {
        "page": {
          "$value": "{ref.color.slot.dark.bg-page}"
        },
        "surface": {
          "$root": {
            "$value": "{ref.color.neutral.900}"
          },
          "raised": {
            "$value": "{ref.color.neutral.900}"
          }
        },
        "fill": {
          "accent": {
            "$value": "{ref.color.slot.dark.bg-fill-accent}"
          }
        },
        "tint": {
          "accent": {
            "$value": "{ref.color.accent.500}",
            "$extensions": {
              "app.prism": {
                "alpha": 0.14
              }
            }
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{ref.color.neutral.0}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface"
                ]
              }
            }
          }
        },
        "secondary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.64,
            "hex": "#ffffff"
          }
        },
        "on-accent": {
          "$value": "{ref.color.slot.dark.text-on-accent}"
        },
        "accent": {
          "$value": "{ref.color.slot.dark.text-accent}"
        }
      }
    },
    "gradient": {
      "$type": "gradient",
      "vivid": {
        "default": {
          "$value": "{ref.gradient.vivid.plum-dusk}"
        }
      }
    }
  }
}
