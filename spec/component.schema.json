{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iiiivaska/prism/spec/component.schema.json",
  "title": "Prism component spec",
  "description": "Contract for one Prism component. Applied to spec/components/*.yaml. See spec/SCHEMA.md for intent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "layer", "specVersion", "status", "summary", "since", "platforms", "schemes", "anatomy", "states", "tokens", "behavior", "accessibility", "usage", "examples"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "layer": { "enum": ["foundation", "primitive", "composite", "dataviz", "pattern"] },
    "specVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "stable", "deprecated"] },
    "replacedBy": { "type": "string" },
    "summary": { "type": "string", "minLength": 20 },
    "since": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ios", "ipados", "macos", "watchos", "web-touch", "web-desktop"],
      "properties": {
        "ios": { "$ref": "#/$defs/support" },
        "ipados": { "$ref": "#/$defs/support" },
        "macos": { "$ref": "#/$defs/support" },
        "watchos": { "$ref": "#/$defs/support" },
        "web-touch": { "$ref": "#/$defs/support" },
        "web-desktop": { "$ref": "#/$defs/support" }
      }
    },
    "density": { "type": "array", "items": { "enum": ["compact", "regular", "comfortable"] }, "uniqueItems": true },
    "modality": { "type": "array", "items": { "enum": ["pointer", "touch"] }, "uniqueItems": true },
    "schemes": { "type": "array", "items": { "enum": ["light", "dark"] }, "minItems": 1, "uniqueItems": true },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part"],
        "properties": {
          "part": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "optional": { "type": "boolean" },
          "description": { "type": "string" },
          "slot": { "type": "boolean", "description": "true when the part accepts arbitrary child content" }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "type": { "enum": ["enum", "boolean", "string", "number", "icon", "slot", "action", "data"] },
          "values": { "type": "array", "items": { "type": "string" } },
          "default": {},
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["default", "hover", "pressed", "focus-visible", "selected", "disabled", "loading", "error", "readonly", "dragging", "expanded"] }
    },
    "tokens": {
      "type": "object",
      "description": "part -> property -> token path or matrix keyed by variant/size/state",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/binding" }
      }
    },
    "behavior": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "motion": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": { "reduceMotion": { "enum": ["none", "crossfade", "instant"] } }
    },
    "haptics": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^haptic\\." } },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "label", "keyboard", "dynamicType", "contrast"],
      "properties": {
        "role": { "type": "string" },
        "label": { "type": "string" },
        "traits": { "type": "array", "items": { "type": "string" } },
        "keyboard": { "type": "string" },
        "dynamicType": { "type": "string" },
        "contrast": { "type": "string" },
        "reduceTransparency": { "type": "string" },
        "reduceMotion": { "type": "string" },
        "voiceOver": { "type": "string" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "dont"],
      "properties": {
        "do": { "type": "array", "items": { "type": "string" } },
        "dont": { "type": "array", "items": { "type": "string" } }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "props"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "props": { "type": "object" },
          "surface": { "enum": ["solid", "vivid", "glass", "image"] },
          "description": { "type": "string" }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "object", "additionalProperties": { "type": "string" } },
        "design": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "support": { "enum": ["full", "adapted", "none"] },
    "tokenPath": { "type": "string", "pattern": "^(comp\\.[a-z0-9-]+|color|type|space|size|radius|elevation|opacity|motion|border|material|gradient|chart|icon|z)\\.[a-z0-9.-]+$", "description": "A sys.* token written without the sys prefix, or a comp.<component>.* token" },
    "binding": {
      "oneOf": [
        { "$ref": "#/$defs/tokenPath" },
        {
          "type": "object",
          "description": "matrix keyed by variant, size or state name",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/binding" }
        }
      ]
    }
  }
}
