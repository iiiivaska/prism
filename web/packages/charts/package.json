{
  "name": "@iiiivaska/prism-charts",
  "version": "0.1.0",
  "description": "Prism data-viz components on visx and d3-shape behind the chart spec",
  "type": "module",
  "private": false,
  "sideEffects": ["**/*.css"],
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./package.json": "./package.json" },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": { "react": "^19", "react-dom": "^19" },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": { "type": "git", "url": "https://github.com/iiiivaska/prism.git", "directory": "web/packages/charts" },
  "publishConfig": { "registry": "https://npm.pkg.github.com", "access": "restricted" },
  "engines": { "node": ">=22.12" },
  "license": "MIT"
}
