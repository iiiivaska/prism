{
  "name": "prism-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24", "pnpm": ">=12" },
  "packageManager": "pnpm@12.4.1",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint:literals": "pnpm --filter @iiiivaska/prism-tools lint:literals",
    "lint:reference-copy": "pnpm --filter @iiiivaska/prism-tools lint:reference-copy",
    "tokens:validate": "pnpm --filter @iiiivaska/prism-tools tokens:validate",
    "tokens:lint": "pnpm --filter @iiiivaska/prism-tools tokens:lint",
    "tokens:normalize": "pnpm --filter @iiiivaska/prism-tools tokens:normalize",
    "tokens:normalize:check": "pnpm --filter @iiiivaska/prism-tools tokens:normalize:check",
    "tokens:build": "pnpm --filter @iiiivaska/prism-tools tokens:build",
    "tokens:check": "pnpm --filter @iiiivaska/prism-tools tokens:check",
    "tokens:diff": "pnpm --filter @iiiivaska/prism-tools tokens:diff",
    "contrast:check": "pnpm --filter @iiiivaska/prism-tools contrast:check",
    "fonts:check": "pnpm --filter @iiiivaska/prism-tools fonts:check",
    "spec:validate": "pnpm --filter @iiiivaska/prism-tools spec:validate",
    "icons:validate": "pnpm --filter @iiiivaska/prism-tools icons:validate",
    "icons:build": "pnpm --filter @iiiivaska/prism-tools icons:build",
    "licenses:check": "pnpm --filter @iiiivaska/prism-tools licenses:check",
    "licenses:notices": "pnpm --filter @iiiivaska/prism-tools licenses:notices",
    "parity:report": "pnpm --filter @iiiivaska/prism-tools parity:report",
    "gallery:build": "pnpm --filter @iiiivaska/prism-tools gallery:build",
    "release:plan": "pnpm --filter @iiiivaska/prism-tools release:plan",
    "release:stamp": "pnpm --filter @iiiivaska/prism-tools release:stamp",
    "release:check": "pnpm --filter @iiiivaska/prism-tools release:check",
    "release:pack": "pnpm --filter @iiiivaska/prism-tools release:pack",
    "fixtures:web": "pnpm --filter @iiiivaska/prism-tools fixtures:web",
    "fixtures:apple": "pnpm --filter @iiiivaska/prism-tools fixtures:apple",
    "showcase:apple": "pnpm --filter @iiiivaska/prism-tools showcase:apple",
    "showcase:apple:generate": "pnpm --filter @iiiivaska/prism-tools showcase:apple:generate",
    "gallery": "pnpm --filter @iiiivaska/prism-gallery dev",
    "stories": "pnpm --filter @iiiivaska/prism-gallery stories",
    "showcase": "pnpm --filter @iiiivaska/prism-showcase dev",
    "showcase:web": "pnpm --filter @iiiivaska/prism-showcase dev",
    "showcase:build": "pnpm --filter @iiiivaska/prism-showcase build",
    "showcase:preview": "pnpm --filter @iiiivaska/prism-showcase preview",
    "vrt": "pnpm --filter @iiiivaska/prism-vrt test",
    "vrt:update": "pnpm --filter @iiiivaska/prism-vrt run test:update",
    "release:version": "changeset version && pnpm release:stamp && pnpm icons:build && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
