{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Prism",
  "version": "2025.10",
  "description": "Prism token resolution: ref -> brand -> sys -> platform -> colorScheme -> density -> modality -> motion -> comp. Modifiers own disjoint token ids (ADR-0024 §9); pnpm tokens:lint and tokens:build check orthogonality.",
  "sets": {
    "ref": {
      "sources": [
        { "$ref": "ref/color.palette.tokens.json" },
        { "$ref": "ref/gradient.tokens.json" },
        { "$ref": "ref/dimension.tokens.json" },
        { "$ref": "ref/typography.tokens.json" },
        { "$ref": "ref/motion.tokens.json" },
        { "$ref": "ref/elevation.tokens.json" },
        { "$ref": "ref/opacity.tokens.json" }
      ]
    },
    "sys": {
      "sources": [
        { "$ref": "sys/base.tokens.json" }
      ]
    },
    "comp": {
      "sources": [
        { "$ref": "comp/area-chart.tokens.json" },
        { "$ref": "comp/avatar.tokens.json" },
        { "$ref": "comp/badge.tokens.json" },
        { "$ref": "comp/button.tokens.json" },
        { "$ref": "comp/card.tokens.json" },
        { "$ref": "comp/checkbox.tokens.json" },
        { "$ref": "comp/chip.tokens.json" },
        { "$ref": "comp/dialog.tokens.json" },
        { "$ref": "comp/icon-button.tokens.json" },
        { "$ref": "comp/list-row.tokens.json" },
        { "$ref": "comp/pagination.tokens.json" },
        { "$ref": "comp/pill-tabs.tokens.json" },
        { "$ref": "comp/progress-bar.tokens.json" },
        { "$ref": "comp/progress-ring.tokens.json" },
        { "$ref": "comp/radio.tokens.json" },
        { "$ref": "comp/ring-gauge.tokens.json" },
        { "$ref": "comp/segmented-control.tokens.json" },
        { "$ref": "comp/select.tokens.json" },
        { "$ref": "comp/sheet.tokens.json" },
        { "$ref": "comp/sidebar.tokens.json" },
        { "$ref": "comp/skeleton.tokens.json" },
        { "$ref": "comp/slider.tokens.json" },
        { "$ref": "comp/sparkline.tokens.json" },
        { "$ref": "comp/spinner.tokens.json" },
        { "$ref": "comp/table.tokens.json" },
        { "$ref": "comp/text-area.tokens.json" },
        { "$ref": "comp/text-field.tokens.json" },
        { "$ref": "comp/timeline.tokens.json" },
        { "$ref": "comp/toggle.tokens.json" },
        { "$ref": "comp/tooltip.tokens.json" },
        { "$ref": "comp/top-bar.tokens.json" }
      ]
    }
  },
  "modifiers": {
    "brand": {
      "contexts": {
        "prism": [ { "$ref": "../brands/prism/brand.tokens.json" } ],
        "prism-native": [ { "$ref": "../brands/prism/brand.tokens.json" }, { "$ref": "../brands/prism-native/brand.tokens.json" } ]
      },
      "default": "prism"
    },
    "platform": {
      "contexts": {
        "apple": [ { "$ref": "sys/platform/apple.tokens.json" } ],
        "web": [ { "$ref": "sys/platform/web.tokens.json" } ],
        "watch": [ { "$ref": "sys/platform/apple.tokens.json" }, { "$ref": "sys/platform/watch.tokens.json" } ]
      },
      "default": "web"
    },
    "colorScheme": {
      "contexts": {
        "light": [ { "$ref": "sys/color/light.tokens.json" } ],
        "dark": [ { "$ref": "sys/color/dark.tokens.json" } ],
        "light-increased-contrast": [ { "$ref": "sys/color/light.tokens.json" }, { "$ref": "sys/color/light-increased-contrast.tokens.json" } ],
        "dark-increased-contrast": [ { "$ref": "sys/color/dark.tokens.json" }, { "$ref": "sys/color/dark-increased-contrast.tokens.json" } ],
        "light-reduced-transparency": [ { "$ref": "sys/color/light.tokens.json" } ],
        "dark-reduced-transparency": [ { "$ref": "sys/color/dark.tokens.json" } ]
      },
      "default": "light"
    },
    "density": {
      "contexts": {
        "compact": [ { "$ref": "sys/density/compact.tokens.json" } ],
        "regular": [ { "$ref": "sys/density/regular.tokens.json" } ],
        "comfortable": [ { "$ref": "sys/density/comfortable.tokens.json" } ],
        "watch": [ { "$ref": "sys/density/regular.tokens.json" }, { "$ref": "sys/density/watch.tokens.json" } ]
      },
      "default": "compact"
    },
    "modality": {
      "contexts": {
        "pointer": [ { "$ref": "sys/modality/pointer.tokens.json" } ],
        "touch": [ { "$ref": "sys/modality/touch.tokens.json" } ]
      },
      "default": "pointer"
    },
    "motion": {
      "contexts": {
        "default": [ { "$ref": "sys/motion/default.tokens.json" } ],
        "reduced": [ { "$ref": "sys/motion/default.tokens.json" }, { "$ref": "sys/motion/reduced.tokens.json" } ]
      },
      "default": "default"
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/ref" },
    { "$ref": "#/modifiers/brand" },
    { "$ref": "#/sets/sys" },
    { "$ref": "#/modifiers/platform" },
    { "$ref": "#/modifiers/colorScheme" },
    { "$ref": "#/modifiers/density" },
    { "$ref": "#/modifiers/modality" },
    { "$ref": "#/modifiers/motion" },
    { "$ref": "#/sets/comp" }
  ]
}
