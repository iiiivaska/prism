    { "fg": "color.icon.status.critical", "bg": "color.bg.tint.critical", "tier": "boundary", "schemes": ["dark"], "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "dark only: in light the critical glyph on its own wash falls below 3:1 over the page and the raised step (2.80 and 2.94), the B4 case of docs/research/a11y-reconciliation.md §8.3, so the word beside it carries the tone (the Alert title, the Banner sentence, the pill label, and the label of a destructive Menu or ContextMenu item on its critical highlight)" },
    { "fg": "color.icon.status.success", "bg": "color.bg.tint.success", "tier": "boundary", "schemes": ["dark"], "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "dark only, as on the solid family (B4)" },
