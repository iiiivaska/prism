    { "fg": "color.text.info", "bg": "color.bg.surface.raised", "tier": "functional" },
    { "fg": "color.text.primary", "bg": "color.bg.tint.accent", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface"], "note": "tints are translucent in dark and sit on the page or on a card (critic G-13)" },
    { "fg": "color.text.success", "bg": "color.bg.tint.success", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface"] },
    { "fg": "color.text.warning", "bg": "color.bg.tint.warning", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface"] },
