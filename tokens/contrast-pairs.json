    { "fg": "color.icon.primary", "bg": "color.bg.fill.neutral.subtle", "tier": "boundary", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "glyphs on a highlighted row: the check of a selected menu item, a tab's glyph under the pill hover, StatusPill's neutral dot" },
