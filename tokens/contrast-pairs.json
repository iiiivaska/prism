    { "fg": "color.bg.fill.inverse", "bg": "color.bg.surface.raised", "tier": "boundary" },
    { "fg": "color.bg.fill.inverse", "bg": "color.bg.fill.neutral.subtle", "tier": "boundary", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "the filled length against its track carries meaning: comp.progress-bar.fill and comp.progress-ring.arc over comp.progress-bar.track, and comp.toggle.track.on beside track.off; the track is 6 % over the ground, so each ground is checked under it. The same mark on the hover and selected overlay is Table's selected-row rule" },
    { "fg": "color.bg.fill.inverse", "bg": "color.bg.surface.nested", "tier": "boundary", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "the inverse selection rule of a pressed ListRow (comp.list-row.rule.selected); Table's selected-row rule sits on the neutral overlay above" },
    { "fg": "color.chart.axis", "bg": "color.chart.plot", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "axis labels are text; marks sit on the plot area, which sits on the page, a card or a raised surface, the glass fallback included (ADR-0022 §1.1; critic G-14)" },
    { "fg": "color.text.accent", "bg": "color.chart.plot", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "an accent label inside the plot is text, not a mark: ReferenceLine's `tone: accent` label and RangeBand's `fill: accent` label on the value axis. color.chart.now stays the mark only, because in light it is accent.500 at 2.30:1 on white (docs/research/visual-dna.md Appendix B, B3); outside the plot the same label is covered by the text.accent pairs on the page, surface, raised and nested grounds" },
    { "fg": "color.chart.series.1", "bg": "color.chart.plot", "tier": "boundary", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "series pairs guard every brand's chart palette (ADR-0020 §4)" },
