    { "fg": "color.bg.fill.inverse", "bg": "color.bg.page", "tier": "boundary", "note": "the inverse solid used as a mark, not as a ground: the Slider fill and thumb, the checked Checkbox and Radio box, the SegmentedControl pill" },
