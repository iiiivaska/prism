    { "fg": "color.text.on-glass-light", "bg": "material.glass.light.chip", "tier": "functional", "schemes": ["dark"], "backdrops": ["#283126", "#3A3A3A"] },
    { "fg": "color.text.on-glass-light", "bg": "material.glass.light.fill", "tier": "functional", "schemes": ["light"], "backdrops": ["#555555", "gradient.vivid.*"], "note": "ADR-0022 §3.3: in light, light glass sits only over vivid or over imagery at OKLCH L 0.45 or lighter; its text is ink" },
    { "fg": "color.text.on-glass-light", "bg": "material.glass.light.chip", "tier": "functional", "schemes": ["light"], "backdrops": ["#555555", "gradient.vivid.*"] },
    { "fg": "color.text.on-vivid", "bg": "gradient.vivid.*", "tier": "functional", "minSizePx": 24, "stops": "all", "note": "ADR-0022 V1: every stop and every sampled point reaches the large tier against white" },
    { "fg": "color.text.on-vivid", "bg": "gradient.vivid.*", "tier": "functional", "region": "card-header", "note": "ADR-0022 V2: the Card header block (two-line headline and caption) reaches the functional tier at every reference geometry" },
    { "fg": "color.border.strong", "bg": "color.bg.page", "tier": "boundary" },
    { "fg": "color.border.strong", "bg": "color.bg.surface", "tier": "boundary", "note": "outline controls such as the ghost button" },
