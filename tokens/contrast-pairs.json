    { "fg": "color.text.primary", "bg": "color.bg.surface.nested", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "the nested step under text: Table's pinned header and footer, ChartContainer's table twin and ListRow's pressed fill. Translucent in both schemes, so it is checked over the page, a card and a raised panel. color.border.strong and color.border.boundary on it stay unpaired (docs/research/a11y-reconciliation.md §8.2)" },
    { "fg": "color.text.secondary", "bg": "color.bg.surface.nested", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"] },
    { "fg": "color.text.tertiary", "bg": "color.bg.surface.nested", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "SearchField's 12 px shortcut hint in a field on a nested ground" },
    { "fg": "color.text.accent", "bg": "color.bg.surface.nested", "tier": "functional", "underlays": ["color.bg.page", "color.bg.surface", "color.bg.surface.raised"], "note": "an accent chart label outside the plot on a nested ground: RangeBand's time-window label and ReferenceLine's label moved outside the plot" },
    { "fg": "color.text.on-inverse", "bg": "color.bg.fill.inverse", "tier": "functional", "note": "the inverse material, including a selected glass Surface under the fallback (ADR-0022 §1.6)" },
