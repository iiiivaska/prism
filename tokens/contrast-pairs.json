    { "fg": "color.text.on-accent-strong", "bg": "color.bg.fill.accent-strong", "tier": "functional", "minSizePx": 24, "schemes": ["dark"], "note": "critic G-13: dark accent-strong carries white text at the large tier only, as its token description states (ADR-0011: >= 24 px regular)" },
