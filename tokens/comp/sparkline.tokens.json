{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "comp": {
    "sparkline": {
      "height": {
        "$type": "dimension",
        "table": {
          "$value": "{sys.space.6}",
          "$description": "sparkline height in a table row: the row's text line box (docs/research/dataviz-design.md §3 rule D20, §6)",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "WIDTH_HEIGHT"
                ]
              }
            }
          }
        },
        "tile": {
          "$value": "{sys.space.10}",
          "$description": "sparkline height in a stat tile or a card aside: twice the table height (docs/research/visual-dna.md §8.4, dataviz-design.md §3 rule D20)",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "WIDTH_HEIGHT"
                ]
              }
            }
          }
        }
      }
    }
  }
}
