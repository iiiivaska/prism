{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "comp": {
    "button": {
      "primary": {
        "$type": "color",
        "bg": {
          "rest": {
            "$value": "{sys.color.bg.fill.inverse}",
            "$description": "solid inverse pill is the only fill",
            "$extensions": {
              "app.prism": {
                "figma": {
                  "collection": "component",
                  "scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ]
                }
              }
            }
          },
          "pressed": {
            "$value": "{sys.color.bg.fill.inverse-pressed}",
            "$description": "the pressed pill: one lightness step from the rest fill, so a press shows with no scale under Reduce Motion (ADR-0039); on vivid the spec binds color.bg.fill.inverse-media-pressed",
            "$extensions": {
              "app.prism": {
                "figma": {
                  "collection": "component",
                  "scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ]
                }
              }
            }
          }
        },
        "text": {
          "$value": "{sys.color.text.on-inverse}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        }
      },
      "secondary": {
        "$type": "color",
        "bg": {
          "rest": {
            "$value": "{sys.color.bg.surface.raised}",
            "$extensions": {
              "app.prism": {
                "figma": {
                  "collection": "component",
                  "scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ]
                }
              }
            }
          },
          "pressed": {
            "$value": "{sys.color.bg.surface.nested}",
            "$extensions": {
              "app.prism": {
                "figma": {
                  "collection": "component",
                  "scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ]
                }
              }
            }
          }
        },
        "text": {
          "$value": "{sys.color.text.primary}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "border": {
          "$value": "{sys.color.border.hairline}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      },
      "ghost": {
        "$type": "color",
        "bg": {
          "pressed": {
            "$value": "{sys.color.bg.fill.neutral.subtle}",
            "$description": "the ghost is outlined and transparent at rest; pressed takes the neutral subtle fill (ADR-0029 §3.3)",
            "$extensions": {
              "app.prism": {
                "figma": {
                  "collection": "component",
                  "scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ]
                }
              }
            }
          }
        },
        "text": {
          "$value": "{sys.color.text.primary}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "border": {
          "$value": "{sys.color.border.strong}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      },
      "danger": {
        "$type": "color",
        "bg": {
          "rest": {
            "$value": "{sys.color.bg.tint.critical}",
            "$extensions": {
              "app.prism": {
                "figma": {
                  "collection": "component",
                  "scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ]
                }
              }
            }
          }
        },
        "text": {
          "$value": "{sys.color.text.critical}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "border": {
          "$value": "{sys.color.text.critical}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{sys.radius.control}",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "component",
              "scopes": [
                "CORNER_RADIUS"
              ]
            }
          }
        }
      },
      "height": {
        "$type": "dimension",
        "sm": {
          "$value": "{sys.size.control.sm}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "WIDTH_HEIGHT"
                ]
              }
            }
          }
        },
        "md": {
          "$value": "{sys.size.control.md}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "WIDTH_HEIGHT"
                ]
              }
            }
          }
        },
        "lg": {
          "$value": "{sys.size.control.lg}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "WIDTH_HEIGHT"
                ]
              }
            }
          }
        }
      },
      "padding-x": {
        "$type": "dimension",
        "sm": {
          "$value": "{sys.space.4}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "GAP"
                ]
              }
            }
          }
        },
        "md": {
          "$value": "{sys.space.5}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "GAP"
                ]
              }
            }
          }
        },
        "lg": {
          "$value": "{sys.space.6}",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "GAP"
                ]
              }
            }
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{sys.space.3}",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "component",
              "scopes": [
                "GAP"
              ]
            }
          }
        }
      },
      "motion": {
        "$type": "transition",
        "press": {
          "$value": "{sys.motion.spring.snappy}"
        }
      }
    }
  }
}
