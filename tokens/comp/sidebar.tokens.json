{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "comp": {
    "sidebar": {
      "active": {
        "bg": {
          "$type": "color",
          "$value": "{sys.color.bg.fill.inverse}",
          "$description": "the destination the reader is in: the one inverse solid of the rail, against bare rows for every other item (visual-dna §1 principle 9)",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "FRAME_FILL",
                  "SHAPE_FILL"
                ]
              }
            }
          }
        },
        "text": {
          "$type": "color",
          "$value": "{sys.color.text.on-inverse}",
          "$description": "the label and the glyph of the active destination; the pair color.text.on-inverse on color.bg.fill.inverse is checked in tokens/contrast-pairs.json",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        }
      },
      "rail": {
        "width": {
          "$type": "dimension",
          "$value": "{sys.space.12}",
          "$description": "the width of the icon rail; space.12 is the references' 64 px icon-rail gutter (visual-dna §6.1, §6.4), which the role's number does not say",
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "component",
                "scopes": [
                  "WIDTH_HEIGHT"
                ]
              }
            }
          }
        }
      }
    }
  }
}
