{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "comp": {
    "surface": {
      "$type": "color",
      "page": {
        "$value": "{sys.color.bg.page}"
      },
      "solid": {
        "$value": "{sys.color.bg.surface}"
      },
      "raised": {
        "$value": "{sys.color.bg.surface.raised}"
      },
      "nested": {
        "$value": "{sys.color.bg.surface.nested}"
      },
      "inverse": {
        "$value": "{sys.color.bg.fill.inverse}"
      },
      "glass": {
        "$value": "{sys.material.glass.dark.fill}"
      },
      "plot": {
        "$value": "{sys.color.chart.plot}"
      }
    }
  }
}
