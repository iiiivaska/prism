{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "comp": {
    "progress-ring": {
      "track": {
        "$type": "color",
        "$value": "{sys.color.bg.fill.neutral.subtle}",
        "$description": "the unfilled circumference: the neutral subtle fill, one quiet step over the surface ladder rather than a grey of its own (dataviz-design.md §3 E25)",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "component",
              "scopes": [
                "STROKE_COLOR",
                "SHAPE_FILL"
              ]
            }
          }
        }
      },
      "arc": {
        "$type": "color",
        "$value": "{sys.color.bg.fill.inverse}",
        "$description": "the value arc is the inverse solid (ink in light, white in dark); the accent means attention, never progress (visual-dna §1 principles 3 and 9)",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "component",
              "scopes": [
                "STROKE_COLOR",
                "SHAPE_FILL"
              ]
            }
          }
        }
      },
      "stroke-min": {
        "$type": "dimension",
        "$value": "{sys.space.1}",
        "$description": "4 px: the floor under chart.gauge-stroke-ratio, from dataviz-design.md §3 E25's minimum ring stroke",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "component",
              "scopes": [
                "STROKE_FLOAT"
              ]
            }
          }
        }
      }
    }
  }
}
