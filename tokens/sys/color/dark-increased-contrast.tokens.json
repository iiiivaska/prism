{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "text": {
        "secondary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.8,
            "hex": "#ffffff"
          }
        },
        "tertiary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.7,
            "hex": "#ffffff"
          }
        },
        "dimmed": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.64,
            "hex": "#ffffff"
          }
        }
      },
      "border": {
        "hairline": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.25,
            "hex": "#ffffff"
          }
        },
        "strong": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.6,
            "hex": "#ffffff"
          }
        }
      },
      "chart": {
        "grid": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.25,
            "hex": "#ffffff"
          }
        },
        "target": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.85,
            "hex": "#ffffff"
          }
        },
        "comparison": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.6,
            "hex": "#ffffff"
          }
        }
      }
    }
  }
}
