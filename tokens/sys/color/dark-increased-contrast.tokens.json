{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "text": {
        "secondary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.8,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface",
                  "color.bg.surface.raised",
                  "color.bg.tint.success",
                  "color.bg.tint.warning",
                  "color.bg.tint.critical",
                  "color.bg.tint.info",
                  "color.bg.fill.neutral.subtle",
                  "color.bg.surface.nested"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "tertiary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.7,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface",
                  "color.bg.surface.raised",
                  "color.bg.fill.neutral.subtle"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "dimmed": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.64,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.surface",
                  "color.bg.surface.raised"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        }
      },
      "border": {
        "hairline": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.25,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        },
        "strong": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.6,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      },
      "chart": {
        "grid": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.25,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "SHAPE_FILL",
                  "STROKE_COLOR"
                ]
              }
            }
          }
        },
        "target": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.85,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "SHAPE_FILL",
                  "STROKE_COLOR"
                ]
              }
            }
          }
        },
        "comparison": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.6,
            "hex": "#ffffff"
          },
          "$extensions": {
            "app.prism": {
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "SHAPE_FILL",
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      }
    }
  }
}
