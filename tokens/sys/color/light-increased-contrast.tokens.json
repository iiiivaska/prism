{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "text": {
        "secondary": {
          "$value": "{ref.color.neutral.700}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface",
                  "color.bg.surface.raised",
                  "color.bg.tint.success",
                  "color.bg.tint.warning",
                  "color.bg.tint.critical",
                  "color.bg.tint.info",
                  "color.bg.fill.neutral.subtle",
                  "color.bg.surface.nested"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "tertiary": {
          "$value": "{ref.color.neutral.700}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface",
                  "color.bg.surface.raised",
                  "color.bg.fill.neutral.subtle"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "dimmed": {
          "$value": "{ref.color.neutral.600}",
          "$description": "dimmed digits become secondary under Increase Contrast",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.surface",
                  "color.bg.surface.raised"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        },
        "accent": {
          "$value": "{ref.color.accent.900}",
          "$extensions": {
            "app.prism": {
              "a11y": {
                "pairsWith": [
                  "color.bg.page",
                  "color.bg.surface",
                  "color.bg.surface.raised"
                ]
              },
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "TEXT_FILL"
                ]
              }
            }
          }
        }
      },
      "border": {
        "hairline": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "alpha": 0.3,
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        },
        "strong": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "alpha": 0.6,
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      },
      "chart": {
        "grid": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "alpha": 0.2,
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "SHAPE_FILL",
                  "STROKE_COLOR"
                ]
              }
            }
          }
        },
        "target": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "alpha": 0.75,
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "SHAPE_FILL",
                  "STROKE_COLOR"
                ]
              }
            }
          }
        },
        "comparison": {
          "$value": "{ref.color.neutral.950}",
          "$extensions": {
            "app.prism": {
              "alpha": 0.6,
              "figma": {
                "collection": "colorScheme",
                "scopes": [
                  "SHAPE_FILL",
                  "STROKE_COLOR"
                ]
              }
            }
          }
        }
      }
    }
  }
}
