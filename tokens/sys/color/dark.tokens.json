{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "color": {
      "$type": "color",
      "bg": {
        "page": {
          "$value": "{ref.color.neutral.950}",
          "$description": "never pure #000; optional radial vignette +3-10% toward the hero"
        },
        "surface": {
          "$root": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.06,
              "hex": "#ffffff"
            },
            "$description": "surface-1 = #1C1C1F over page; no border, no shadow"
          },
          "raised": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.09,
              "hex": "#ffffff"
            },
            "$description": "surface-2 = #232426: tiles, pills, nested; optional 1 px white 8% top edge on tiles and nav pills only"
          },
          "nested": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.12,
              "hex": "#ffffff"
            },
            "$description": "surface-3 = #2A2B2E: translucent card over map, control on card"
          },
          "overlay": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.12,
              "hex": "#ffffff"
            }
          }
        },
        "fill": {
          "inverse": {
            "$value": "{ref.color.neutral.0}",
            "$description": "active segmented button, send button; black glyph"
          },
          "accent": {
            "$value": "{ref.color.accent.500}",
            "$description": "the one attention KPI tile; content is ink (8.3:1)"
          },
          "accent-strong": {
            "$value": "{ref.color.accent.600}",
            "$description": "white text >= 18 px only (3.05:1)"
          },
          "critical": {
            "$value": "{ref.color.status.danger.badge}"
          },
          "neutral": {
            "subtle": {
              "$value": {
                "colorSpace": "srgb",
                "components": [
                  1.0,
                  1.0,
                  1.0
                ],
                "alpha": 0.06,
                "hex": "#ffffff"
              }
            }
          }
        },
        "tint": {
          "accent": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.9529,
                0.5804,
                0.2667
              ],
              "alpha": 0.14,
              "hex": "#f39444"
            },
            "$description": "orange band under a flagged chart window (= #2D2118 on page)"
          },
          "success": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.3608,
                0.7961,
                0.4157
              ],
              "alpha": 0.1,
              "hex": "#5ccb6a"
            }
          },
          "warning": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.9608,
                0.7216,
                0.2392
              ],
              "alpha": 0.1,
              "hex": "#f5b83d"
            }
          },
          "critical": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                0.2745,
                0.2588
              ],
              "alpha": 0.1,
              "hex": "#ff4642"
            },
            "$description": "alert sub-card = #332022 on surface-1"
          },
          "info": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.4196,
                0.5176,
                0.8784
              ],
              "alpha": 0.1,
              "hex": "#6b84e0"
            }
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{ref.color.neutral.0}",
          "$description": "numerals pure white; body may use #F5F6F8"
        },
        "secondary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.64,
            "hex": "#ffffff"
          },
          "$description": "7.6:1 on surface-1 / 6.3:1 on surface-3"
        },
        "tertiary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.55,
            "hex": "#ffffff"
          },
          "$description": "6.0:1 / 5.0:1: axis labels, timestamps (reference 45-50% failed on surface-3)"
        },
        "dimmed": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.42,
            "hex": "#ffffff"
          },
          "$description": "4.0:1 / 3.35:1: trailing digits and units >= 24 pt only (reference 35-40% was 2.3-2.9:1)"
        },
        "on-inverse": {
          "$value": "{ref.color.neutral.950}"
        },
        "on-accent": {
          "$value": "{ref.color.neutral.950}"
        },
        "on-accent-strong": {
          "$value": "{ref.color.neutral.0}"
        },
        "on-vivid": {
          "$value": "{ref.color.neutral.0}"
        },
        "on-glass": {
          "$value": "{ref.color.neutral.0}",
          "$description": "captions never below 78% white on light glass"
        },
        "on-badge": {
          "$value": "{ref.color.neutral.0}"
        },
        "accent": {
          "$value": "{ref.color.accent.500}",
          "$description": "7.4:1 on surface-1; text allowed at >= 12 px"
        },
        "success": {
          "$value": "{ref.color.status.success.dark}"
        },
        "warning": {
          "$value": "{ref.color.status.warning.dark}"
        },
        "critical": {
          "$value": "{ref.color.status.danger.dark}"
        },
        "info": {
          "$value": "{ref.color.status.info.dark}"
        }
      },
      "icon": {
        "primary": {
          "$value": "{ref.color.neutral.0}"
        },
        "secondary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.64,
            "hex": "#ffffff"
          }
        },
        "accent": {
          "$value": "{ref.color.accent.500}"
        },
        "status": {
          "success": {
            "$value": "{ref.color.status.success.dark}"
          },
          "warning": {
            "$value": "{ref.color.status.warning.dark}"
          },
          "critical": {
            "$value": "{ref.color.status.danger.mark-dark}"
          },
          "info": {
            "$value": "{ref.color.status.info.mark-dark}"
          }
        }
      },
      "border": {
        "hairline": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.08,
            "hex": "#ffffff"
          },
          "$description": "table rows, tile top edge"
        },
        "strong": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.35,
            "hex": "#ffffff"
          },
          "$description": "outline pills"
        },
        "focus": {
          "$value": "{ref.color.neutral.0}"
        },
        "boundary": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.3,
            "hex": "#ffffff"
          }
        }
      },
      "accent": {
        "$root": {
          "$value": "{ref.color.accent.500}"
        },
        "pressed": {
          "$value": "{ref.color.accent.400}"
        },
        "subtle": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9529,
              0.5804,
              0.2667
            ],
            "alpha": 0.14,
            "hex": "#f39444"
          }
        },
        "glow": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9529,
              0.5804,
              0.2667
            ],
            "alpha": 0.4,
            "hex": "#f39444"
          }
        }
      },
      "chart": {
        "series": {
          "1": {
            "$value": "{ref.color.series.dark.1}"
          },
          "2": {
            "$value": "{ref.color.series.dark.2}"
          },
          "3": {
            "$value": "{ref.color.series.dark.3}"
          },
          "4": {
            "$value": "{ref.color.series.dark.4}"
          },
          "5": {
            "$value": "{ref.color.series.dark.5}"
          },
          "6": {
            "$value": "{ref.color.series.dark.6}"
          }
        },
        "comparison": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.4,
            "hex": "#ffffff"
          }
        },
        "comparison-2": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.25,
            "hex": "#ffffff"
          }
        },
        "target": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.6,
            "hex": "#ffffff"
          }
        },
        "grid": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.12,
            "hex": "#ffffff"
          }
        },
        "band": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.06,
            "hex": "#ffffff"
          }
        },
        "axis": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.55,
            "hex": "#ffffff"
          }
        },
        "now": {
          "$value": "{ref.color.accent.500}"
        },
        "ghost": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.12,
            "hex": "#ffffff"
          }
        },
        "plot": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.06,
            "hex": "#ffffff"
          },
          "$description": "charts never sit on raw glass"
        }
      }
    },
    "material": {
      "glass": {
        "dark": {
          "fill": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.0627,
                0.0784,
                0.0627
              ],
              "alpha": 0.6,
              "hex": "#101410"
            },
            "$description": "panel / sheet / card over map; takes the backdrop hue",
            "$extensions": {
              "app.prism": {
                "blur": 32,
                "saturate": 1.2,
                "edge": {
                  "alpha": 0.15,
                  "to": 0.0
                },
                "grain": 0.0
              }
            }
          },
          "chip": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.16,
              "hex": "#ffffff"
            },
            "$description": "controls over map or render; toolbar 0.25",
            "$extensions": {
              "app.prism": {
                "blur": 20,
                "edge": {
                  "alpha": 0.2,
                  "to": 0.12
                }
              }
            }
          }
        },
        "light": {
          "fill": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.26,
              "hex": "#ffffff"
            },
            "$description": "the selected / foreground object; only over dark imagery (backdrop L <= 35%); bloom clipped away from text",
            "$extensions": {
              "app.prism": {
                "blur": 40,
                "bloom": {
                  "alpha": 0.35
                }
              }
            }
          },
          "chip": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "alpha": 0.16,
              "hex": "#ffffff"
            },
            "$extensions": {
              "app.prism": {
                "blur": 20
              }
            }
          }
        },
        "cell": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.2,
            "hex": "#ffffff"
          },
          "$description": "status cells over a render: fill tinted <= 20% toward the status hue, 1.5 px status border carries the status",
          "$extensions": {
            "app.prism": {
              "blur": 12
            }
          }
        },
        "scrim": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.4,
            "hex": "#000000"
          },
          "$description": "modal backdrop dim; text scrim over bright photos"
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "raised": {
        "$value": "{ref.shadow.none}",
        "$description": "dark E1 is a +3% luminance step, not a shadow"
      },
      "floating": {
        "$value": "{ref.shadow.dark.floating}"
      },
      "overlay": {
        "$value": "{ref.shadow.dark.overlay}"
      },
      "drawer": {
        "$value": "{ref.shadow.dark.modal}"
      },
      "flat": {
        "$value": "{ref.shadow.none}"
      }
    }
  }
}
