{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "size": {
      "$type": "dimension",
      "hit": {
        "$value": "{ref.size.hit.pointer}",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "modality",
              "scopes": [
                "WIDTH_HEIGHT"
              ]
            }
          }
        }
      }
    },
    "interaction": {
      "$type": "number",
      "hover": {
        "$value": 1,
        "$description": "hover states exist",
        "$extensions": {
          "app.prism": {
            "flag": true
          }
        }
      },
      "tooltip": {
        "$value": 1,
        "$extensions": {
          "app.prism": {
            "flag": true
          }
        }
      }
    }
  }
}
