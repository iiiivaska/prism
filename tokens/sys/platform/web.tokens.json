{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "font": {
      "$type": "fontFamily",
      "ui": {
        "$value": "{ref.font.ui}",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "platform",
              "scopes": [
                "FONT_FAMILY"
              ]
            }
          }
        }
      },
      "display": {
        "$value": "{ref.font.display}",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "platform",
              "scopes": [
                "FONT_FAMILY"
              ]
            }
          }
        }
      },
      "mono": {
        "$value": "{ref.font.mono}",
        "$extensions": {
          "app.prism": {
            "figma": {
              "collection": "platform",
              "scopes": [
                "FONT_FAMILY"
              ]
            }
          }
        }
      }
    }
  }
}
