{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "font": {
      "$type": "fontFamily",
      "ui": {
        "$value": "{ref.font.ui}"
      },
      "display": {
        "$value": "{ref.font.display}"
      },
      "mono": {
        "$value": "{ref.font.mono}"
      }
    },
    "material": {
      "blur": {
        "$type": "number",
        "enabled": {
          "$value": 1
        }
      }
    }
  }
}
