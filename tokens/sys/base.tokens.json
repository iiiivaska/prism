      "$type": "strokeStyle",
      "target": {
        "$value": {
          "dashArray": [
            {
              "value": 8,
              "unit": "px"
            },
            {
              "value": 6,
              "unit": "px"
            }
          ],
          "lineCap": "round"
        },
        "$description": "dashed reference / target line"
      },
      "grid": {
        "$value": {
          "dashArray": [
            {
              "value": 4,
              "unit": "px"
            },
            {
              "value": 6,
              "unit": "px"
            }
          ],
          "lineCap": "butt"
        },
        "$description": "horizontal gridlines only; never solid, never vertical"
      },
