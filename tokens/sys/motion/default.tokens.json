{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "motion": {
      "duration": {
        "$type": "duration",
        "instant": {
          "$value": "{ref.motion.duration.instant}"
        },
        "quick": {
          "$value": "{ref.motion.duration.quick}"
        },
        "fast": {
          "$value": "{ref.motion.duration.fast}"
        },
        "base": {
          "$value": "{ref.motion.duration.base}"
        },
        "slow": {
          "$value": "{ref.motion.duration.slow}"
        },
        "slower": {
          "$value": "{ref.motion.duration.slower}"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "out": {
          "$value": "{ref.motion.easing.out}",
          "$description": "enter and exit (exit mirrors enter), press and release feedback, the Reduce Motion substitutes, state changes on the non-spring path (ADR-0023 §9)"
        },
        "in-out": {
          "$value": "{ref.motion.easing.in-out}",
          "$description": "on-screen movement and morphs on the non-spring path (ADR-0023 §9)"
        },
        "drawer": {
          "$value": "{ref.motion.easing.drawer}",
          "$description": "sheets and drawers on the non-spring path (ADR-0023 §9)"
        },
        "hover": {
          "$value": "{ref.motion.easing.hover}",
          "$description": "hover color and opacity only (ADR-0023 §9)"
        },
        "linear": {
          "$value": "{ref.motion.easing.linear}",
          "$description": "constant motion: progress, marquee, ambient rotation (ADR-0023 §9)"
        }
      },
      "spring": {
        "$type": "transition",
        "interactive": {
          "$value": "{ref.motion.spring.interactive}"
        },
        "snappy": {
          "$value": "{ref.motion.spring.snappy}"
        },
        "smooth": {
          "$value": "{ref.motion.spring.smooth}"
        },
        "sheet": {
          "$value": "{ref.motion.spring.sheet}"
        },
        "bouncy": {
          "$value": "{ref.motion.spring.bouncy}"
        }
      },
      "presentation": {
        "$type": "number",
        "crossfade": {
          "$value": 0,
          "$description": "Flag. 1 under Reduce Motion: outside an active gesture nothing scales, rotates, blurs or changes depth; presentations fade by opacity over motion.duration.base with motion.easing.out; in-place movement keeps its spring (ADR-0023 §8.4).",
          "$extensions": {
            "app.prism": {
              "flag": true
            }
          }
        }
      }
    }
  }
}
