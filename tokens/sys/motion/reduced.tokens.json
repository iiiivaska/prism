{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "sys": {
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": {
            "value": 100,
            "unit": "ms"
          }
        },
        "base": {
          "$value": {
            "value": 150,
            "unit": "ms"
          }
        },
        "slow": {
          "$value": {
            "value": 150,
            "unit": "ms"
          }
        },
        "slower": {
          "$value": {
            "value": 150,
            "unit": "ms"
          }
        }
      },
      "spring": {
        "$type": "transition",
        "snappy": {
          "$value": {
            "duration": {
              "value": 367,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$description": "Reduce Motion: state changes without overshoot, shortened (ADR-0023)",
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.25,
                "bounce": 0.0,
                "settle": 0.367
              }
            }
          }
        },
        "smooth": {
          "$value": {
            "duration": {
              "value": 440,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.in-out}"
          },
          "$description": "Reduce Motion: layout and morph without overshoot, shortened (ADR-0023)",
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.3,
                "bounce": 0.0,
                "settle": 0.44
              }
            }
          }
        },
        "sheet": {
          "$value": {
            "duration": {
              "value": 367,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$description": "Reduce Motion: sheets and drawers without overshoot, shortened (ADR-0023)",
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.25,
                "bounce": 0.0,
                "settle": 0.367
              }
            }
          }
        },
        "bouncy": {
          "$value": {
            "duration": {
              "value": 440,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$description": "Reduce Motion: the delight tier without bounce, shortened (ADR-0023)",
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.3,
                "bounce": 0.0,
                "settle": 0.44
              }
            }
          }
        }
      },
      "presentation": {
        "$type": "number",
        "crossfade": {
          "$value": 1,
          "$description": "Flag. 1 under Reduce Motion: outside an active gesture nothing scales, rotates, blurs or changes depth; presentations fade by opacity over motion.duration.base with motion.easing.out; in-place movement keeps its spring (ADR-0023 §8.4).",
          "$extensions": {
            "app.prism": {
              "flag": true
            }
          }
        }
      }
    }
  }
}
