        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Web stack of the mono slot: served families and CSS generics only (ADR-0020)"
      },
      "apple": {
        "$description": "Apple face of each slot: exactly one family the brand bundles on Apple, or one system keyword (system-ui, ui-rounded, ui-monospace, ui-serif); the platform modifier selects it for apple and watch (ADR-0020 §5).",
        "ui": {
          "$value": [
            "Onest"
          ]
        },
        "display": {
          "$value": [
            "Onest"
          ]
        },
        "mono": {
          "$value": [
            "JetBrains Mono"
          ]
        }
      }
