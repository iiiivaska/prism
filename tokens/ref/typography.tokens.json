        "xl": {
          "$value": {
            "fontFamily": "{ref.font.display}",
            "fontSize": {
              "value": 64,
              "unit": "px"
            },
            "fontWeight": 300,
            "lineHeight": 1.0,
            "letterSpacing": {
              "value": -1.28,
              "unit": "px"
            }
          },
          "$extensions": {
            "app.prism": {
              "slot": "display",
              "numeric": "proportional",
              "textStyle": "largeTitle"
            }
          },
          "$description": "page hero title set into the backdrop; never thin (ADR-0021)"
        },
