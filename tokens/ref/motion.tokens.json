{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "motion": {
      "duration": {
        "$type": "duration",
        "instant": {
          "$value": {
            "value": 0,
            "unit": "ms"
          },
          "$description": "no animation: keyboard-initiated and 100+/day actions"
        },
        "quick": {
          "$value": {
            "value": 100,
            "unit": "ms"
          },
          "$description": "press feedback, hover color"
        },
        "fast": {
          "$value": {
            "value": 150,
            "unit": "ms"
          },
          "$description": "tooltips, small popovers"
        },
        "base": {
          "$value": {
            "value": 250,
            "unit": "ms"
          },
          "$description": "dropdowns, toasts, crossfades"
        },
        "slow": {
          "$value": {
            "value": 350,
            "unit": "ms"
          },
          "$description": "modals, sheets on the non-spring path"
        },
        "slower": {
          "$value": {
            "value": 500,
            "unit": "ms"
          },
          "$description": "first-run and explanatory only"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "out": {
          "$value": [
            0.23,
            1,
            0.32,
            1
          ]
        },
        "inOut": {
          "$value": [
            0.77,
            0,
            0.175,
            1
          ]
        },
        "drawer": {
          "$value": [
            0.32,
            0.72,
            0,
            1
          ]
        },
        "hover": {
          "$value": [
            0.25,
            0.1,
            0.25,
            1
          ]
        },
        "linear": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        }
      },
      "spring": {
        "$type": "transition",
        "interactive": {
          "$value": {
            "duration": {
              "value": 220,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.15,
                "bounce": 0.0,
                "settle": 0.22,
                "blendDuration": 0.25
              }
            }
          },
          "$description": "tracks a live gesture; Apple interactiveSpring defaults"
        },
        "snappy": {
          "$value": {
            "duration": {
              "value": 487,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.35,
                "bounce": 0.15,
                "settle": 0.487
              }
            }
          },
          "$description": "default for state changes: toggles, segmented controls, selection, popovers"
        },
        "smooth": {
          "$value": {
            "duration": {
              "value": 587,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.inOut}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.4,
                "bounce": 0.0,
                "settle": 0.587
              }
            }
          },
          "$description": "reposition / layout / morph with no overshoot"
        },
        "sheet": {
          "$value": {
            "duration": {
              "value": 404,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.drawer}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.3,
                "bounce": 0.2,
                "settle": 0.404
              }
            }
          },
          "$description": "sheets and drawers after a flick or drag release"
        },
        "bouncy": {
          "$value": {
            "duration": {
              "value": 818,
              "unit": "ms"
            },
            "delay": {
              "value": 0,
              "unit": "ms"
            },
            "timingFunction": "{ref.motion.easing.out}"
          },
          "$extensions": {
            "app.prism": {
              "spring": {
                "duration": 0.5,
                "bounce": 0.3,
                "settle": 0.818
              }
            }
          },
          "$description": "delight tier only"
        }
      }
    }
  }
}
