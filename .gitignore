# macOS
.DS_Store
# Swift
.build/
DerivedData/
*.xcuserstate
.swiftpm/xcode/xcuserdata/
# Node
node_modules/
dist/
.turbo/
web/apps/gallery/storybook-static/
web/apps/vrt/test-results/
# The gallery's collected copies (P3-5): the canon is each harness's own baselines, and gallery/index.html
# and gallery/index.json are committed. `pnpm gallery:build` fills this folder in seconds.
gallery/snapshots/
web/apps/vrt/playwright-report/
# The showcase apps (P3-7, docs/showcase.md). Their build output is already ignored above — `dist/` covers
# web/apps/showcase/dist, `DerivedData/` covers what `pnpm showcase:apple` builds into a temporary directory,
# and the generated swift/Showcase/PrismShowcase.xcodeproj is ignored by that app's own .gitignore. What is
# left is pixels: the gallery and the visual-regression suite own every committed image (ADR-0005), the two
# showcase apps record none, and a screenshot taken while driving one is a working file. `git add -f` if an
# app ever needs a real raster asset.
swift/Showcase/**/*.png
web/apps/showcase/**/*.png
# Generated outputs are committed on purpose (see ADR-004); never ignore them.
# Local
.env
*.log
# Claude Code local state
.claude/worktrees/
.claude/settings.local.json
